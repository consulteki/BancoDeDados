generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Aluno {
  id          BigInt      @id @default(autoincrement()) @map("id_aluno")
  matricula   String      @unique @db.VarChar(30)
  nome        String      @db.VarChar(150)
  nomeSocial  String?     @map("nome_social") @db.VarChar(150)
  email       String?     @unique @db.VarChar(254)
  situacao    String      @default("ATIVO") @db.VarChar(20)
  matriculas  Matricula[]

  @@map("aluno")
}

model Turma {
  id          BigInt      @id @default(autoincrement()) @map("id_turma")
  disciplinaId BigInt     @map("id_disciplina")
  codigo      String      @db.VarChar(30)
  periodo     String      @db.VarChar(20)
  capacidade  Int?
  situacao    String      @db.VarChar(20)
  matriculas  Matricula[]

  @@map("turma")
}

model Matricula {
  id               BigInt   @id @default(autoincrement()) @map("id_matricula")
  alunoId          BigInt   @map("id_aluno")
  turmaId          BigInt   @map("id_turma")
  dataMatricula    DateTime @map("data_matricula") @db.Date
  situacao         String   @default("ATIVA") @db.VarChar(20)
  formaIngresso    String?  @map("forma_ingresso") @db.VarChar(30)
  dataCancelamento DateTime? @map("data_cancelamento") @db.Date
  aluno            Aluno    @relation(fields: [alunoId], references: [id])
  turma            Turma    @relation(fields: [turmaId], references: [id])

  @@unique([alunoId, turmaId, dataMatricula], map: "uq_matricula_aluno_turma_data")
  @@map("matricula")
}
